POSTGRES_IMAGE=mirror.gcr.io/library/postgres:17
POSTGRES_USER=nano
POSTGRES_PASSWORD=nano
POSTGRES_DB=nano_chat_test
POSTGRES_PORT=5432
APP_PORT=3000
NANO_CHAT_IMAGE=nano-chat:local
# Optional explicit override; if set, keep this URL in sync with POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB.
# DATABASE_URL=postgres://nano:nano@postgres:5432/nano_chat_test
JWT_SECRET=change-me-development-secret-at-least-32-bytes
BIND_ADDR=0.0.0.0:3000
RUST_LOG=nano_chat=debug,tower_http=info
WEB_DIST_DIR=web/dist
NANO_CHAT_NOTIFY_CHANNEL=nano_chat_events
NANO_CHAT_MAX_CONNECTIONS_PER_USER=10
NANO_CHAT_HEARTBEAT_INTERVAL_SECS=30
NANO_CHAT_HEARTBEAT_IDLE_TIMEOUT_SECS=90
NANO_CHAT_MAX_WS_PAYLOAD_BYTES=65536
NANO_CHAT_MAX_MESSAGE_BYTES=4096
NANO_CHAT_CALL_RINGING_TIMEOUT_SECS=60
NANO_CHAT_CALL_DISCONNECT_GRACE_SECS=15
NANO_CHAT_CALL_CLEANUP_INTERVAL_SECS=5
